# Copy to server/.env and adjust. Every value here has a working default.

PORT=4000
# Change this before any real deployment — it signs the session tokens.
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_TTL=12h

# Where the SQLite database and uploaded documents live.
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# ---- business rules ---------------------------------------------------
# Expenses at or above this amount need Director approval and are paid by
# accounts; below it the Senior Manager is final and the supervisor pays
# from petty cash.
EXPENSE_DIRECTOR_THRESHOLD=3000
# Advance payment runs up to this many requests go through internet banking;
# beyond it a bank upload sheet is generated.
NETBANKING_MAX_REQUESTS=4

# ---- WhatsApp (Meta Cloud API) ----------------------------------------
# Leave blank to run broadcasts in simulation mode.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# ---- OCR for "scan the registration page" -----------------------------
# Any service that accepts a multipart "file" and returns { text: "..." }.
# Leave blank to fall back to pasting the page text into the form.
OCR_API_URL=
OCR_API_KEY=
