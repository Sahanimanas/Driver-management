# Copy to server/.env and adjust. Every value here has a working default.

PORT=4000
# Change this before any real deployment — it signs the session tokens.
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_TTL=12h

# Where the SQLite database and uploaded documents live.
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# ---- branding ---------------------------------------------------------
# Fallbacks only — the name, tagline and logo are set in Settings at runtime
# and stored in the database, so these are what a fresh install starts with.
APP_NAME=Quantum
APP_TAGLINE=Driver Attendance & Management

# ---- business rules ---------------------------------------------------
# Every advance and expense is approved by Admin / Director. This threshold
# decides who then PAYS an expense: below it the supervisor pays from petty
# cash and uploads the supporting; at or above it Finance pays the vendor.
EXPENSE_DIRECTOR_THRESHOLD=3000
# Advance payment runs up to this many requests go through internet banking;
# beyond it a bank upload sheet is generated.
NETBANKING_MAX_REQUESTS=4

# ---- WhatsApp (Meta Cloud API) ----------------------------------------
# Leave blank to run broadcasts in simulation mode.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# ---- OCR for "scan the registration page" -----------------------------
# Scanning works out of the box: a PDF with a text layer is read directly, and
# anything else goes through the bundled local OCR engine (tesseract.js).
#
# Set OCR_API_URL to prefer a remote service instead — anything that accepts a
# multipart "file" and returns JSON. The usual shapes ({text}, OCR.space,
# Google Vision) are all understood, and the local engine remains the fallback.
OCR_API_URL=
OCR_API_KEY=
# How long to wait for one page to be read, and for the local engine to start
# (its language pack is downloaded on first use). A stall past either gives the
# supervisor a clear error and the paste-the-text fallback, rather than a spinner.
OCR_TIMEOUT_MS=60000
OCR_STARTUP_TIMEOUT_MS=120000
# tesseract.js language packs, '+'-joined. Add 'hin' for Devanagari on Aadhaar.
OCR_LANGUAGES=eng
